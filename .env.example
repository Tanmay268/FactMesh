# Copy this file to .env and fill in what you have. Nothing here is required to
# START the app -- a prebuilt database is committed under data/, so the app runs
# and shows results with zero keys. A key is only needed to process NEW PDFs.
#
# Provider is picked automatically: whichever of these is set first wins, in
# this order: GEMINI_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY. If none are
# set, the app tries a local Ollama server (http://localhost:11434) instead.

# Free, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Paid. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Paid. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Only used if none of the above are set. Point at a local Ollama install.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3
OLLAMA_EMBED_MODEL=nomic-embed-text

# Where the SQLite database lives.
DATABASE_PATH=data/knowledge.db
